{
  "$schema": "https://typedoc.org/schema.json",
  "cleanOutputDir": true,
  "customCss": "./docs-theme.css",
  "disableGit": true,
  "displayBasePath": "../kysely/src",
  "entryPoints": [
    "../kysely/src/index.ts",
    "../kysely/src/helpers/*.ts",
    "../kysely/src/migration/index.ts",
  ],
  "entryPointStrategy": "expand",
  "excludeExternals": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "sql",
  ],
  "out": "./docs",
  "placeInternalsInOwningModule": true,
  "plugin": ["typedoc-plugin-missing-exports"],
  "sourceLinkExternal": true,
  "sourceLinkTemplate": "https://github.com/kysely-org/kysely/blob/master/src/{path}#L{line}",
  "tsconfig": "../kysely/tsconfig.json",
}
